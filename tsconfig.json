{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "src/js",
    "outDir": "dist/js"
  },
  "include": ["src/js/**/*.ts"]
}
